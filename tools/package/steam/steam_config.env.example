# Steamworks developer configuration
# ========================
# Tip: copy this file to steam_config.env and fill in your real values.
# steam_config.env is ignored by .gitignore to avoid leaking passwords and sensitive IDs.

# Your Steam login account (a dedicated build sub-account without two-factor auth is recommended)
STEAM_USERNAME=your_build_account_name

# [Optional] Your Steam login password. If left empty, the script securely prompts for it at runtime
# STEAM_PASSWORD=your_build_account_password

# Your game's main App ID
STEAM_APP_ID=1234567

# Your game's Depot ID (usually App ID + 1; check the Steamworks dashboard)
STEAM_DEPOT_ID=1234568

# Absolute path to steamcmd.exe, inside the builder folder of the Steamworks SDK you downloaded
# Example: D:\Steamworks_SDK\tools\ContentBuilder\builder\steamcmd.exe
STEAM_CMD_PATH=C:\path\to\your\steamworks_sdk\tools\ContentBuilder\builder\steamcmd.exe

# The default LLM seed has moved to tools/package/desktop/desktop_seed.env.
# The Steam upload config only holds Steamworks/SteamCMD fields.
