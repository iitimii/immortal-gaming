# Frontend Dockerfile (multi-stage build)
FROM node:22-alpine AS builder

# Set working directory
WORKDIR /app

# Copy package.json and package-lock.json
COPY web/package.json web/package-lock.json* ./

# Install dependencies
RUN npm ci

# Copy frontend source
COPY web/ .
# Copy the locale registry required by the frontend build
COPY static/locales/registry.json /static/locales/registry.json
# Copy shared game configs required by the frontend build
COPY static/game_configs/world_info.csv /static/game_configs/world_info.csv
# Build frontend
RUN npm run build

# Production stage - Nginx
FROM nginx:alpine

# Copy build output
COPY --from=builder /app/dist /usr/share/nginx/html

# Copy Nginx config
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf

# Expose port
EXPOSE 80

# Nginx starts automatically
