# Backend Dockerfile
FROM python:3.12-bookworm

# Set working directory
WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy runtime dependency files
COPY requirements-runtime.txt .

# Install Python dependencies
# Uses the official PyPI by default so CI does not fail when a third-party mirror is unavailable.
# To use a mirror, override at build time:
#   docker build --build-arg PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple ...
ARG PIP_INDEX_URL=https://pypi.org/simple
RUN pip install --no-cache-dir -r requirements-runtime.txt -i ${PIP_INDEX_URL}

# Copy project code
COPY src/ ./src/
COPY static/ ./static/
COPY assets/ ./assets/

# Expose port
EXPOSE 8002

# Start command
CMD ["uvicorn", "src.server.main:app", "--host", "0.0.0.0", "--port", "8002"]
