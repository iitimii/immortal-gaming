#. auxiliary.csv: Kunlun Mirror
msgid "AUXILIARY_2052_NAME"
msgstr "Kunlun Mirror"

#. auxiliary.csv: Seizing the creation of heaven and earth, gathe...
msgid "AUXILIARY_2053_DESC"
